name: Cross-Agent Approval Enforcer

on:
  pull_request_review:
    types: [submitted]

jobs:
  check-reviewer:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Verify Reviewer with Config
        id: verify
        run: |
          # Extract variables from GitHub Event
          PR_AUTHOR="${{ github.event.pull_request.user.login }}"
          REVIEWER="${{ github.event.review.user.login }}"
          
          echo "PR Author: $PR_AUTHOR"
          echo "Reviewer: $REVIEWER"
          
          # Read configuration from JSON file
          CONFIG_FILE="agents_config.json"
          
          # Use jq to find the expected approver for the given author
          # Note: This logic assumes the 'username' in JSON matches GitHub login.
          EXPECTED_APPROVER=$(jq -r --arg author "$PR_AUTHOR" 'to_entries[] | select(.value.username == $author) | .value.approver' "$CONFIG_FILE")
          
          if [[ -z "$EXPECTED_APPROVER" || "$EXPECTED_APPROVER" == "null" ]]; then
            echo "Author $PR_AUTHOR not found in $CONFIG_FILE. Skipping policy check."
            exit 0
          fi
          
          echo "Expected Approver: $EXPECTED_APPROVER"
          
          if [[ "$REVIEWER" != "$EXPECTED_APPROVER" ]]; then
            echo "Error: Only $EXPECTED_APPROVER can approve PRs from $PR_AUTHOR."
            exit 1
          fi
          
          echo "Approval policy satisfied."
